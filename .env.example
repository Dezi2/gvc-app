# =============================================================================
# APPLICATION
# =============================================================================

APP_NAME="Global Value Chain"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Lagos
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Bcrypt cost. Lower = faster tests, higher = stronger hashing.
# Use 12 in production, 4 in tests (set automatically via phpunit.xml).
BCRYPT_ROUNDS=12

# =============================================================================
# LOGGING
# =============================================================================

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =============================================================================
# DATABASE (MySQL)
# =============================================================================

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gvc_db
DB_USERNAME=root
DB_PASSWORD=

# =============================================================================
# SESSION
# =============================================================================

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# =============================================================================
# CACHE + QUEUE + BROADCAST
# =============================================================================

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# =============================================================================
# MAIL (used by Laravel Breeze for password reset)
# =============================================================================
# In local development, use "log" so emails go to storage/logs/laravel.log
# In production, switch to a real mail provider (Mailgun, SMTP, etc.)

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@gvc.com"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
# VITE (frontend build)
# =============================================================================

VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# AWS (optional — not used in this project, but kept for completeness)
# =============================================================================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false